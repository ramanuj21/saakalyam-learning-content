{
  "$id": "urn:saakalyam:learning:0.1.0:agent",
  "$schema": "https://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/header"
    },
    {
      "properties": {
        "agentKind": {
          "enum": [
            "person",
            "organisation",
            "pseudonym"
          ]
        },
        "displayName": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "entityType": {
          "const": "agent"
        },
        "externalIdentifiers": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "properties": {
                    "value": {
                      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
                      "type": "string"
                    }
                  }
                },
                "if": {
                  "properties": {
                    "scheme": {
                      "const": "github"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
                      "type": "string"
                    }
                  }
                }
              }
            ],
            "properties": {
              "scheme": {
                "enum": [
                  "github",
                  "orcid"
                ]
              },
              "value": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "scheme",
              "value"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "ownership": {
          "allOf": [
            {
              "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/ownership"
            },
            {
              "properties": {
                "scope": {
                  "const": "shared"
                }
              }
            }
          ]
        },
        "publicLinks": {
          "items": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "agentKind",
        "displayName"
      ],
      "type": "object"
    }
  ],
  "propertyNames": {
    "enum": [
      "id",
      "entityType",
      "schemaVersion",
      "revision",
      "origin",
      "attributions",
      "rightsId",
      "ownership",
      "provenance",
      "agentKind",
      "displayName",
      "externalIdentifiers",
      "publicLinks"
    ]
  },
  "type": "object"
}
