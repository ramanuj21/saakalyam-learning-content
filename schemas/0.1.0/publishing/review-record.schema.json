{
  "$id": "urn:saakalyam:learning:0.1.0:review-record",
  "$schema": "https://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/header"
    },
    {
      "properties": {
        "conflictsOfInterest": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "authorship",
                  "translation",
                  "editing",
                  "rights-holder",
                  "submission",
                  "other"
                ]
              },
              "note": {
                "minLength": 1,
                "type": "string"
              },
              "resolution": {
                "const": "requires-independent-review"
              }
            },
            "required": [
              "kind",
              "note",
              "resolution"
            ],
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        },
        "contextUri": {
          "format": "uri",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "changes-requested",
            "rejected",
            "disputed",
            "unable-to-determine"
          ]
        },
        "dependencyRefs": {
          "items": {
            "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "entityType": {
          "const": "review-record"
        },
        "evidenceRefs": {
          "items": {
            "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "reviewScope": {
          "enum": [
            "scholarly",
            "source-fidelity",
            "pedagogical",
            "editorial",
            "rights",
            "technical"
          ]
        },
        "reviewType": {
          "enum": [
            "sanskrit-domain",
            "source-fidelity",
            "pedagogical",
            "editorial",
            "rights",
            "technical-schema"
          ]
        },
        "reviewedAt": {
          "format": "date-time",
          "type": "string"
        },
        "reviewerRef": {
          "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
        },
        "reviewerRole": {
          "enum": [
            "domain-reviewer",
            "source-reviewer",
            "pedagogical-reviewer",
            "editorial-reviewer",
            "rights-reviewer",
            "technical-reviewer"
          ]
        },
        "scope": {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "not": {
                  "required": [
                    "fields"
                  ]
                }
              },
              "if": {
                "properties": {
                  "kind": {
                    "const": "fields"
                  }
                }
              },
              "then": {
                "required": [
                  "fields"
                ]
              }
            }
          ],
          "properties": {
            "fields": {
              "items": {
                "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "kind": {
              "enum": [
                "whole-record",
                "fields"
              ]
            },
            "note": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "targetRef": {
          "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
        },
        "targetSha256": {
          "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/sha256"
        },
        "unresolvedIssues": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "targetRef",
        "targetSha256",
        "reviewerRef",
        "reviewScope",
        "decision",
        "reviewedAt",
        "rationale",
        "dependencyRefs"
      ],
      "type": "object"
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "scholarly"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "sanskrit-domain"
          },
          "reviewerRole": {
            "const": "domain-reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "source-fidelity"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "source-fidelity"
          },
          "reviewerRole": {
            "const": "source-reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "pedagogical"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "pedagogical"
          },
          "reviewerRole": {
            "const": "pedagogical-reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "editorial"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "editorial"
          },
          "reviewerRole": {
            "const": "editorial-reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "rights"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "rights"
          },
          "reviewerRole": {
            "const": "rights-reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewScope": {
            "const": "technical"
          }
        }
      },
      "then": {
        "properties": {
          "reviewType": {
            "const": "technical-schema"
          },
          "reviewerRole": {
            "const": "technical-reviewer"
          }
        }
      }
    }
  ],
  "propertyNames": {
    "enum": [
      "id",
      "entityType",
      "schemaVersion",
      "revision",
      "origin",
      "attributions",
      "rightsId",
      "ownership",
      "provenance",
      "targetRef",
      "targetSha256",
      "reviewerRef",
      "reviewScope",
      "decision",
      "reviewedAt",
      "rationale",
      "dependencyRefs",
      "contextUri",
      "reviewType",
      "reviewerRole",
      "evidenceRefs",
      "limitations",
      "unresolvedIssues",
      "scope",
      "conflictsOfInterest"
    ]
  },
  "type": "object"
}
