        },
        "representationRefs": {
          "items": {
            "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "componentKind",
        "attachment",
        "representationRefs"
      ],
      "type": "object"
    }
  ],
  "propertyNames": {
