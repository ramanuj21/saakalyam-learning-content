    },
    {
      "properties": {
        "editionRef": {
          "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/pinnedRef"
        },
        "entityType": {
          "const": "source-reference"
        },
        "locator": {
          "$ref": "urn:saakalyam:learning:0.1.0:common#/definitions/locator"
